-- 00_clear_sample_data.sql
-- ใช้เมื่อต้องการ "ล้างข้อมูลตัวอย่าง" ทั้งหมดก่อนใส่ข้อมูลจริง
-- ⚠️ คำสั่งนี้ลบข้อมูลทุกอย่างในระบบ รวมคำขอ/ประวัติที่มีอยู่ด้วย
-- ถ้ายังอยากเก็บคำขอ/ประวัติเดิมไว้ ให้ข้ามไฟล์นี้ไปเลย แล้วแค่
-- เพิ่มแผนก/หน่วยงาน/พนักงานใหม่เพิ่มเติมจากของเดิมแทน
-- ============================================================

truncate table
  transfer_history,
  transfer_request_items,
  transfer_requests,
  employees,
  units,
  departments
restart identity cascade;

-- รันเสร็จแล้วตารางทั้งหมดจะว่างเปล่า พร้อมเริ่มนำเข้าข้อมูลจริง
